# 1주차 Render PostgreSQL의 External Database URL (로컬 개발) / Internal URL (Render에 배포한 백엔드)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
# 과제용 공간 (1주차 테이블과 섞이지 않게)
DB_SCHEMA=hw2
# 로그인 토큰 서명용 비밀값 (아무 긴 문자열)
JWT_SECRET=change-me-to-a-long-random-string
# 요청을 받을 프론트 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
PORT=4000
# 시연 데이터 초기화 버튼 허용 (배포에서는 false)
ALLOW_RESET=true
